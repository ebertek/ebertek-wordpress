{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeStableNonMajor",
    "docker:pinDigests",
    "default:automergeDigest"
  ],
  "schedule": [
    "at any time"
  ],
  "packageRules": [
    {
      "description": "Track WordPress 8.5 Alpine release tags and rebuilt digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "wordpress"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-php8\\.5-fpm-alpine$"
    }
  ]
}
